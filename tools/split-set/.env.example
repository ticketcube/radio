# Copy to ~/.otw-split-set.env (or .env next to split-set.py) and fill in.
# Only needed for --upload. Never commit the real file.

# AzuraCast (Administration > API Keys). Best: a key for a user who can only manage this station's media.
AZURACAST_URL=https://radio.onestowatch.live
AZURACAST_API_KEY=
AZURACAST_STATION_ID=2

# AIMC (same values the site's server uses)
AIMC_API_URL=https://otw.aimc-ln.com/v1
AIMC_API_KEY=
AIMC_UPLOAD_CONNECTOR_ID=115b2c89-246f-4d8f-8c83-71fd7fe77644
AIMC_UPLOAD_FOLDER=OTW/OTWL_Audio
